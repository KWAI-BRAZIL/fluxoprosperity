# Front (Vite) — essas variáveis entram no bundle. Nunca coloque a service role aqui.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Checkout Cakto — use o link do ACESSO ÚNICO (R$14,97), não assinatura mensal
VITE_CAKTO_CHECKOUT_URL=

# Somente no Supabase (Edge Functions). NÃO prefixar com VITE_.
SUPABASE_SERVICE_ROLE_KEY=
CAKTO_WEBHOOK_SECRET=
GEMINI_API_KEY=

# Opcional: IDs dos produtos/ofertas na Cakto para mapear o campo `produto`
CAKTO_PRODUCT_ACESSO_ID=
CAKTO_PRODUCT_LEITURA_ID=
CAKTO_PRODUCT_ASSINATURA_ID=
